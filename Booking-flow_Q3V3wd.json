{"updatedAt":"2026-02-26T15:30:02.801Z","createdAt":"2026-02-26T09:58:38.082Z","id":"Q3V3wd1XURDvENnk","name":"Booking flow","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[0,0],"id":"4edd121f-37ea-4ad8-8539-fbb200933d8e","name":"When Executed by Another Workflow"},{"parameters":{"calendar":{"__rl":true,"value":"2be792a77c44ec3d3e0e56c1602c25ad858bbceb7446716cdb61f53eadb9683e@group.calendar.google.com","mode":"list","cachedResultName":"n8n Testing"},"additionalFields":{"attendees":[]}},"type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[432,-16],"id":"7e4f6ea6-2474-4364-a87b-d51064de1ecd","name":"Create an event","credentials":{"googleCalendarOAuth2Api":{"id":"nXGCK8a3f4yKdcqT","name":"Google Calendar account"}}},{"parameters":{"jsCode":"const { DateTime } = require(\"luxon\");\n\n// Extract values\nconst day = $json.output.day;        // \"6 March\"\nconst startTime = $json.output.startTime; // \"4pm\"\nconst endTime = $json.output.endTime;     // \"5pm\"\n\n// Combine with current year\nconst year = DateTime.now().year;\n\n// Parse start\nconst start = DateTime.fromFormat(\n  `${day} ${year} ${startTime}`,\n  \"d LLLL yyyy ha\",\n  { zone: \"Asia/Kolkata\" }\n);\n\n// Parse end\nconst end = DateTime.fromFormat(\n  `${day} ${year} ${endTime}`,\n  \"d LLLL yyyy ha\",\n  { zone: \"Asia/Kolkata\" }\n);\n\nreturn [\n  {\n    start: start.toISO(),\n    end: end.toISO(),\n    email: $json.output.patient.email,\n    name: $json.output.patient.name,\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[240,16],"id":"64270aa5-3a68-4e3b-b51f-e1f52027cf36","name":"Code in JavaScript"}],"connections":{"When Executed by Another Workflow":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Create an event":{"main":[[]]},"Code in JavaScript":{"main":[[{"node":"Create an event","type":"main","index":0