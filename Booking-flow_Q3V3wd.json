: $json.output.patient.email,\n  }\n  ];\n}\n\nreturn [\n  {\n    status: \"success\",\n    start: startISO,\n    end: endISO,\n    email: $json.output.patient.email,\n    name: $json.output.patient.name,\n    subject: $json.output.subject\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[224,-832],"id":"64270aa5-3a68-4e3b-b51f-e1f52027cf36","name":"Code in JavaScript","retryOnFail":false,"notesInFlow":false},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"23274137-b0db-4063-9e18-59542edfb651","leftValue":"={{$json.status}}","rightValue":"success","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[448,-832],"id":"8252cba6-edc9-4312-b0d3-902ab1297343","name":"If"},{"parameters":{"resource":"calendar","calendar":{"__rl":true,"value":"2be792a77c44ec3d3e0e56c1602c25ad858bbceb7446716cdb61f53eadb9683e@group.calendar.google.com","mode":"list","cachedResultName":"n8n Testing"},"timeMin":"={{ $json.start }}","timeMax":"={{ $json.end }}","options":{}},"type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[672,-832],"id":"822a6cee-a270-4d85-8967-ffe55a30f9b8","name":"Get availability in a calendar","alwaysOutputData":false,"credentials":{"googleCalendarOAuth2Api":{"id":"nXGCK8a3f4yKdcqT","name":"Google Calendar account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"7859006d-0763-4cc0-badd-05fdd07d7aaa","leftValue":"={{ $json.available }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1120,-896],"id":"03768309-f6fb-4cfb-9725-82da52339c4e","name":"If1","alwaysOutputData":false},{"parameters":{"mode":"combine","combineB