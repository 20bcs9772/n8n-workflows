 cancel:\nExtract:\n- targetDate (YYYY-MM-DD)\n- targetStartTime (HH:MM, 24-hour format if mentioned)\n\nFor reschedule:\nExtract:\n- targetDate (original booking date)\n- targetStartTime (original time, if mentioned)\n- newDate (new booking date)\n- newStartTime (HH:MM, 24-hour format)\n- newEndTime (HH:MM, 24-hour format)\n\nIf newEndTime is not provided, set it to one hour after newStartTime.\n\nDo not invent times.\nDo not invent dates.\nOnly extract what is clearly stated or logically derivable.\n\nReturn ONLY valid JSON."}},"type":"@n8n/n8n-nodes-langchain.informationExtractor","typeVersion":1.2,"position":[224,0],"id":"4a595490-eac2-4669-8b39-8afcebc8cd2f","name":"Information Extractor"},{"parameters":{"model":"openai/gpt-4o-mini","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatVercelAiGateway","typeVersion":1,"position":[296,224],"id":"fdd5fb6a-d4cb-46f9-9dd0-0632d8044f93","name":"Vercel AI Gateway Chat Model","credentials":{"vercelAiGatewayApi":{"id":"vCVL6lwt27Af60r8","name":"Vercel AI Gateway account 2"}}},{"parameters":{"operation":"rowExists","dataTableId":{"__rl":true,"value":"V2AwqjzIUJKlreH9","mode":"list","cachedResultName":"Appointments","cachedResultUrl":"/projects/XFDqpPFKxce2amsm/datatables/V2AwqjzIUJKlreH9"},"filters":{"conditions":[{"keyName":"email","keyValue":"={{ $json.patient.email }}"},{"keyName":"startTime","keyValue":"={{ $json.targetStartISO }}"}]}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[800,0],"id":"7e5e868d-5479-4640-aea6-da97b2f42814","name":"If row exists"},{"parameters":{"jsCode":"const date = $json.output.targetDate;\nconst time = $json.output.targetStartTime;\n\nconst iso = DateTime.fromISO(`${date}T${time}`, {\n  zone: \"Asia/Kolkata\"\n}).toISO();\n\nconst formatted = DateTime.fromISO(iso)\n  .setZone(\"Asia/Kolkata\")\n  .toFormat(\"yyyy-MM-dd'T'HH:mm:ssZZ\");\n\nreturn [{\n  ...$json.output,\n  targetStartISO: formatted\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[576,0],"id":